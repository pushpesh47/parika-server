# PARIKA Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Application Settings
PARIKA_APPLICATION__ENVIRONMENT=production
PARIKA_API__HOST=0.0.0.0
PARIKA_API__PORT=2026

# =============================================================================
# PostgreSQL Database Configuration
# =============================================================================
PARIKA_DATABASE__HOST=127.0.0.1
PARIKA_DATABASE__PORT=5432
PARIKA_DATABASE__DATABASE=parika
PARIKA_DATABASE__USERNAME=postgres
PARIKA_DATABASE__PASSWORD=

PARIKA_TEST_DATABASE__HOST=127.0.0.1
PARIKA_TEST_DATABASE__PORT=5432
PARIKA_TEST_DATABASE__NAME=parika_test
PARIKA_TEST_DATABASE__USERNAME=postgres
PARIKA_TEST_DATABASE__PASSWORD=

# =============================================================================
# Routing Model Configuration
# =============================================================================
PARIKA_ROUTING_MODEL__MODE=fixed
PARIKA_ROUTING_TYPE=cloud #local or cloud

PARIKA_ROUTING_MODEL__FIXED_MODEL=qwen3.5:4b
PARIKA_ROUTING_MODEL__FIXED_THINKING=false

PARIKA_ROUTING__CLOUD__PRIMARY_PROVIDER=kilo_code
PARIKA_ROUTING__CLOUD__FALLBACK_PROVIDER=block_run

PARIKA_PROVIDER_KILO_CODE_API_KEY=
PARIKA_PROVIDER_BLOCK_RUN_API_KEY=

# =============================================================================
# Ollama Provider Configuration
# =============================================================================
PARIKA_PROVIDERS__OLLAMA__KEEP_ALIVE=120m

# =============================================================================
# Data Directory
# =============================================================================
PARIKA_DATA__DIRECTORY=data

# =============================================================================
# Media Configuration
# =============================================================================
PARIKA_MEDIA__ALLOWED_LOCAL_ROOTS=

# =============================================================================
# API Authentication
# =============================================================================
# JWT secret for token signing (required when api.auth.mode=jwt)
# PARIKA_API__AUTH__JWT_SECRET=

# API keys for api_key authentication mode (hashed values)
# PARIKA_API__AUTH__API_KEYS=

# =============================================================================
# External Provider Credentials
# =============================================================================
# Google Custom Search Engine (for web_search.google_cse provider)
# PARIKA_WEB_SEARCH__GOOGLE_CSE__API_KEY=
# PARIKA_WEB_SEARCH__GOOGLE_CSE__SEARCH_ENGINE_ID=

